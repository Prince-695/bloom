{
    "name": "@bloom/server",
    "type": "module",
    "private": true,
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "dev": "bun run --hot src/index.ts",
        "build": "bun build src/index.ts --outdir dist --target bun",
        "postinstall": "if [ -z \"$VERCEL\" ] && [ -z \"$CI\" ]; then bun run --cwd ../database db:generate; fi",
        "start": "bun dist/index.js"
    },
    "dependencies": {
        "@ai-sdk/google": "^4.0.8",
        "@ai-sdk/groq": "^4",
        "@ai-sdk/provider-utils": "^5.0.7",
        "@bloom/database": "workspace:*",
        "@bloom/shared": "workspace:*",
        "@hono/zod-validator": "^0.8.0",
        "@sentry/bun": "^10.63.0",
        "@sentry/hono": "^10.63.0",
        "ai": "^7.0.15",
        "better-auth": "^1.6.25",
        "dotenv": "^17.4.2",
        "hono": "^4.12.27",
        "nodemailer": "^9.0.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/nodemailer": "^8.0.1"
    }
}