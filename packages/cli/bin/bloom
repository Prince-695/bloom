#!/usr/bin/env bun
/**
 * Dev entry that always loads repo-root .env, then starts the CLI.
 * Prefer `bun run packages/cli/src/index.tsx` which also loads .env when present.
 */
import dotenv from "dotenv";
import path from "path";

dotenv.config({
  path: path.resolve(import.meta.dirname, "../../../.env"),
  quiet: true,
});

await import("../src/index.tsx");
